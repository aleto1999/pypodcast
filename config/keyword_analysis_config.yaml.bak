  # Analysis settings
  settings:
    # Case sensitivity for keyword matching
    case_sensitive: false

    # Include partial word matches (e.g., "animal" matches "animals")
    partial_matches: true

    # Minimum word length for analysis
    min_word_length: 3

    # Context window around keywords (characters before/after)
    context_window: 100

    # Export formats for results
    export_formats:
      - "json"
      - "csv"
      - "txt"

    # Include speaker information in results (for diarization files)
    include_speaker_info: true

    # Include timestamp information
    include_timestamps: true

    # Minimum confidence threshold for matches (0.0 to 1.0)
    confidence_threshold: 0.7

# =============================================================================
# EMBEDDINGS ANALYSIS CONFIGURATION
# =============================================================================

embeddings_analysis:
  # Model settings for semantic analysis
  model:
    # Sentence transformer model for embeddings
    name: "all-MiniLM-L6-v2"
    # Alternative models:
    # - "all-mpnet-base-v2" (higher quality, slower)
    # - "paraphrase-multilingual-MiniLM-L12-v2" (multilingual)
    # - "sentence-transformers/all-roberta-large-v1" (high performance)

    # Device for model inference
    device: "auto"  # "auto", "cpu", "cuda", "mps"

    # Batch size for processing
    batch_size: 32

    # Maximum sequence length
    max_seq_length: 512

  # Clustering settings
  clustering:
    # Algorithm for clustering embeddings
    algorithm: "kmeans"  # "kmeans", "dbscan", "hierarchical"

    # Number of clusters (for kmeans)
    n_clusters: 10

    # Minimum cluster size (for dbscan)
    min_cluster_size: 5

    # Distance threshold (for hierarchical)
    distance_threshold: 0.5

  # Similarity analysis
  similarity:
    # Similarity threshold for grouping
    threshold: 0.8

    # Method for similarity calculation
    method: "cosine"  # "cosine", "euclidean", "manhattan"

    # Top-k similar segments to return
    top_k: 10

# =============================================================================
# STATISTICAL ANALYSIS CONFIGURATION
# =============================================================================

statistical_analysis:
  # Metrics to calculate
  metrics:
    # Basic statistics
    basic:
      - "word_count"
      - "sentence_count"
      - "paragraph_count"
      - "avg_words_per_sentence"
      - "avg_sentences_per_paragraph"

    # Readability metrics
    readability:
      - "flesch_reading_ease"
      - "flesch_kincaid_grade"
      - "gunning_fog_index"
      - "automated_readability_index"

    # Linguistic features
    linguistic:
      - "pos_tags_distribution"
      - "named_entities"
      - "sentiment_polarity"
      - "sentiment_subjectivity"
      - "lexical_diversity"

    # Content-specific metrics
    content:
      - "keyword_frequency"
      - "keyword_density"
      - "topic_distribution"
      - "emotional_tone"

  # Export settings
  export:
    # Include visualizations
    include_plots: true

    # Plot formats
    plot_formats:
      - "png"
      - "pdf"
      - "svg"

    # Statistical summary format
    summary_format: "comprehensive"  # "basic", "detailed", "comprehensive"

# =============================================================================
# TRANSCRIPT ANALYSIS CONFIGURATION
# =============================================================================

transcript_analysis:
  # Theme detection
  themes:
    # Method for theme extraction
    method: "topic_modeling"  # "topic_modeling", "keyword_clustering", "manual_categories"

    # Number of topics for topic modeling
    n_topics: 15

    # Topic modeling algorithm
    algorithm: "lda"  # "lda", "nmf", "bertopic"

    # Minimum topic probability
    min_topic_prob: 0.1

  # Sentiment analysis
  sentiment:
    # Sentiment analysis model
    model: "vader"  # "vader", "textblob", "roberta", "custom"

    # Granularity level
    granularity: "sentence"  # "document", "paragraph", "sentence", "word"

    # Include confidence scores
    include_confidence: true

    # Sentiment categories
    categories:
      - "positive"
      - "negative"
      - "neutral"
      - "mixed"

  # Speaker-specific analysis (for diarized content)
  speaker_analysis:
    # Enable speaker-specific metrics
    enabled: true

    # Metrics to calculate per speaker
    metrics:
      - "speaking_time"
      - "word_count"
      - "avg_sentiment"
      - "keyword_usage"
      - "topic_focus"
      - "interruption_frequency"

    # Minimum speaking time for inclusion (seconds)
    min_speaking_time: 30

# =============================================================================
# LLM ANNOTATION CONFIGURATION
# =============================================================================

llm_annotation:
  # Model settings
  model:
    # Model name/path
    name: "gpt-3.5-turbo"  # "gpt-3.5-turbo", "gpt-4", "claude-3", "local_model"

    # API settings (if using external API)
    api_key_env: "OPENAI_API_KEY"  # Environment variable for API key
    max_tokens: 2048
    temperature: 0.3

    # Local model settings (if using local model)
    local_model_path: null
    device: "auto"

  # Annotation tasks
  tasks:
    # Dehumanization detection
    dehumanization:
      enabled: true
      prompt_template: |
        Analyze the following text for dehumanizing language. Look for:
        1. Animal metaphors or comparisons
        2. Disease/contamination language
        3. Object or substance comparisons
        4. Denial of human qualities

        Text: {text}

        Provide a JSON response with:
        - "detected": boolean
        - "severity": 1-5 scale
        - "examples": list of specific phrases
        - "explanation": brief explanation

    # Hate speech detection
    hate_speech:
      enabled: true
      prompt_template: |
        Identify potential hate speech in this text:

        Text: {text}

        Response format:
        - "contains_hate_speech": boolean
        - "categories": list of hate speech types
        - "severity": 1-5 scale
        - "explanation": reasoning

    # Topic classification
    topic_classification:
      enabled: true
      categories:
        - "politics"
        - "social_issues"
        - "economy"
        - "culture"
        - "religion"
        - "immigration"
        - "technology"
        - "health"
        - "education"
        - "environment"
      prompt_template: |
        Classify the main topic(s) of this text:

        Text: {text}

        Available categories: {categories}

        Return the most relevant category and confidence score.

  # Processing settings
  processing:
    # Chunk size for long texts
    chunk_size: 1000

    # Overlap between chunks
    chunk_overlap: 100

    # Batch processing size
    batch_size: 5

    # Rate limiting (requests per minute)
    rate_limit: 60

    # Retry settings
    max_retries: 3
    retry_delay: 1  # seconds

# =============================================================================
# OUTPUT CONFIGURATION
# =============================================================================

output:
  # Base output directory
  base_dir: "outputs/analysis"

  # Subdirectories for different analysis types
  subdirs:
    keywords: "keyword_analysis"
    embeddings: "embeddings_analysis"
    statistics: "statistical_analysis"
    transcripts: "transcript_analysis"
    llm_annotations: "llm_annotations"

  # File naming conventions
  filename_format: "{show_name}_{analysis_type}_{timestamp}"

  # Compression settings
  compression:
    enabled: true
    format: "gzip"  # "gzip", "bzip2", "xz"

  # Backup settings
  backup:
    enabled: true
    keep_versions: 5

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

performance:
  # Parallel processing
  parallel:
    enabled: true
    max_workers: 4
    chunk_size: 1000

  # Memory management
  memory:
    max_memory_usage: "8GB"
    enable_garbage_collection: true
    gc_frequency: 100  # operations

  # Caching
  cache:
    enabled: true
    cache_dir: "cache/analysis"
    max_cache_size: "2GB"
    cache_ttl: 86400  # seconds (24 hours)

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

logging:
  # Log level
  level: "INFO"  # "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"

  # Log file settings
  file:
    enabled: true
    path: "logs/analysis.log"
    max_size: "100MB"
    backup_count: 5

  # Console logging
  console:
    enabled: true
    format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"

  # Progress tracking
  progress:
    enabled: true
    update_frequency: 10  # updates per 100 operations
